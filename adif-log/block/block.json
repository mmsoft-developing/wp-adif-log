{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ham2k/adif-log",
	"version": "1.5.0",
	"title": "ADIF log",
	"category": "widgets",
	"icon": "list-view",
	"description": "Searchable QSO log table (with POTA support) from an ADIF (.adi / .adif) file in the media library.",
	"keywords": [ "adif", "log", "qso", "pota", "lotw", "ham2k", "napló" ],
	"textdomain": "adif-log",
	"attributes": {
		"attachmentId": { "type": "number", "default": 0 },
		"fileName": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"location": { "type": "string", "default": "" },
		"showStats": { "type": "boolean", "default": true },
		"showSearch": { "type": "boolean", "default": true },
		"language": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "ham2k-adif-log-editor",
	"viewScript": "ham2k-adif-log-view",
	"style": "ham2k-adif-log",
	"render": "file:./render.php"
}
